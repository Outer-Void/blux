{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:blux:model-api:v1:stream-event",
  "title": "BLUX Model API v1 stream event",
  "description": "One event of a streamed response, one JSON object per line. The last event is 'end' or 'error'.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "model_api_version",
    "seq",
    "type",
    "data"
  ],
  "properties": {
    "contract": {
      "const": "blux.model-stream-event"
    },
    "model_api_version": {
      "$ref": "urn:blux:model-api:v1:common#/$defs/model_api_version"
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "type": {
      "enum": [
        "start",
        "route",
        "delta",
        "tool_call",
        "usage",
        "end",
        "error"
      ]
    },
    "data": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "start"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "model"
            ],
            "properties": {
              "model": {
                "$ref": "urn:blux:model-api:v1:common#/$defs/logical_model"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "route"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "route_id",
              "provider",
              "provider_model",
              "attempt"
            ],
            "properties": {
              "route_id": {
                "$ref": "urn:blux:model-api:v1:common#/$defs/slug"
              },
              "provider": {
                "$ref": "urn:blux:model-api:v1:common#/$defs/slug"
              },
              "provider_model": {
                "$ref": "urn:blux:model-api:v1:common#/$defs/provider_model"
              },
              "attempt": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "delta"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "tool_call"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "urn:blux:model-api:v1:common#/$defs/tool_call"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "usage"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "urn:blux:model-api:v1:common#/$defs/usage"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "end"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "response"
            ],
            "properties": {
              "response": {
                "$ref": "urn:blux:model-api:v1:response"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "error"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "error"
            ],
            "properties": {
              "error": {
                "$ref": "urn:blux:model-api:v1:error"
              }
            }
          }
        }
      }
    }
  ]
}
