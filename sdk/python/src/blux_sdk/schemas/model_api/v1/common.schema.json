{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:blux:model-api:v1:common",
  "title": "BLUX Model API v1 shared definitions",
  "$defs": {
    "model_api_version": {
      "const": "1.0"
    },
    "logical_model": {
      "enum": [
        "blux-main",
        "blux-fast",
        "blux-reason",
        "blux-code"
      ],
      "description": "A BLUX logical model. Callers target these, never a vendor model."
    },
    "capability": {
      "enum": [
        "streaming",
        "tools",
        "structured_output",
        "deterministic",
        "long_context",
        "local_only"
      ]
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"
    },
    "provider_model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]*$"
    },
    "tool_name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "tool_call": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "arguments"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "name": {
          "$ref": "#/$defs/tool_name"
        },
        "arguments": {
          "type": "object"
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "output_tokens",
        "total_tokens",
        "reasoning_tokens",
        "cached_input_tokens",
        "reported_by_provider"
      ],
      "properties": {
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "total_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "reasoning_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cached_input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "reported_by_provider": {
          "type": "boolean"
        }
      }
    },
    "error_code": {
      "enum": [
        "INVALID_REQUEST",
        "UNKNOWN_MODEL",
        "CAPABILITY_UNAVAILABLE",
        "PROVIDER_NOT_CONFIGURED",
        "PROVIDER_AUTH_FAILED",
        "PROVIDER_RATE_LIMITED",
        "PROVIDER_QUOTA_EXCEEDED",
        "PROVIDER_UNAVAILABLE",
        "PROVIDER_ERROR",
        "PROVIDER_TIMEOUT",
        "PROVIDER_REJECTED",
        "CONTEXT_TOO_LONG",
        "CONTENT_FILTERED",
        "STRUCTURED_OUTPUT_INVALID",
        "TOOL_CALL_INVALID",
        "BACKEND_PROTOCOL_ERROR",
        "ALL_ROUTES_FAILED",
        "TIMEOUT",
        "CANCELLED",
        "INTERNAL_ERROR"
      ]
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_id",
        "provider",
        "provider_model",
        "outcome",
        "error_code",
        "retryable",
        "reason",
        "latency_ms",
        "retries"
      ],
      "properties": {
        "route_id": {
          "$ref": "#/$defs/slug"
        },
        "provider": {
          "$ref": "#/$defs/slug"
        },
        "provider_model": {
          "$ref": "#/$defs/provider_model"
        },
        "outcome": {
          "enum": [
            "succeeded",
            "failed",
            "skipped"
          ]
        },
        "error_code": {
          "oneOf": [
            {
              "$ref": "#/$defs/error_code"
            },
            {
              "type": "null"
            }
          ]
        },
        "retryable": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "latency_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "retries": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "linkage": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation_id",
            "parent_operation_id",
            "session_id",
            "project_id",
            "capability_id"
          ],
          "properties": {
            "operation_id": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 128
            },
            "parent_operation_id": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 128
            },
            "session_id": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 128
            },
            "project_id": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 128
            },
            "capability_id": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 128
            }
          }
        }
      ]
    }
  }
}
