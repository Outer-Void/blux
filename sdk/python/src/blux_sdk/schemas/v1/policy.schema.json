{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:blux:contract:v1:policy",
  "title": "BLUX execution policy",
  "description": "Default-deny authorization rules evaluated by the runtime. Deny rules win over allow rules. Destructive capabilities can only be allowed by a rule naming the exact capability_id.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "contract_version", "policy_id", "default_effect", "rules"],
  "properties": {
    "contract": {"const": "blux.policy"},
    "contract_version": {"$ref": "urn:blux:contract:v1:common#/$defs/contract_version"},
    "policy_id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,127}$"},
    "default_effect": {"const": "deny"},
    "rules": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_id", "effect", "capabilities"],
        "properties": {
          "rule_id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,127}$"},
          "effect": {"enum": ["allow", "deny"]},
          "capabilities": {
            "description": "Exact capability_ids or namespace globs ending in .* (e.g. echo.*).",
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*((\\.[a-z][a-z0-9_-]*)+|(\\.[a-z][a-z0-9_-]*)*\\.\\*)$"
            }
          },
          "actor_types": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["user", "agent", "service"]}
          },
          "max_side_effects": {"$ref": "urn:blux:contract:v1:common#/$defs/side_effect"},
          "grants": {
            "description": "Permissions this rule grants. An allow rule applies only if its grants cover every required_permission of the capability.",
            "type": "array",
            "uniqueItems": true,
            "items": {"$ref": "urn:blux:contract:v1:common#/$defs/permission"}
          },
          "reason": {"type": "string", "maxLength": 512}
        }
      }
    }
  }
}
