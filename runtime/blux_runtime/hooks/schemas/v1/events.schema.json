  "$defs": {
    "agent__completed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_id",
        "turns"
      ],
      "properties": {
        "agent_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "turns": {
          "type": "integer",
          "minimum": 0
        }
      },
      "x-blux-hook": {
        "name": "agent.completed",
        "family": "agent",
        "phase": "notify",
        "vetoable": false,
        "mutable": {},
        "sensitive": [],
        "emitters": "owner",
        "summary": "An agent run finished."
      }
    },
    "agent__failed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_id",
        "error_code"
      ],
      "properties": {
        "agent_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "error_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "x-blux-hook": {
        "name": "agent.failed",
        "family": "agent",
        "phase": "notify",
        "vetoable": false,
        "mutable": {},
        "sensitive": [],
        "emitters": "owner",
        "summary": "An agent run failed."
      }
    },
    "agent__spawned": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_id",
        "parent_agent_id",
        "depth",
        "model"
      ],
      "properties": {
        "agent_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "parent_agent_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "depth": {
          "type": "integer",
          "minimum": 0
        },
        "model": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        }
      },
      "x-blux-hook": {
        "name": "agent.spawned",
        "family": "agent",
        "phase": "notify",
        "vetoable": false,
        "mutable": {},
        "sensitive": [],
        "emitters": "owner",
        "summary": "An agent run started."
      }
    },
    "artifact__created": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "name",
        "media_type",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "x-blux-hook": {
        "name": "artifact.created",
        "family": "artifact",
        "phase": "notify",
        "vetoable": false,
        "mutable": {},
        "sensitive": [],
        "emitters": "runtime",
        "summary": "An operation produced an artifact."
      }
    },
    "artifact__modified": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "previous_artifact_id",
        "media_type",
        "sha256"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "previous_artifact_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "x-blux-hook": {
        "name": "artifact.modified",
        "family": "artifact",
        "phase": "notify",
        "vetoable": false,
        "mutable": {},
        "sensitive": [],
        "emitters": "owner",
        "summary": "An artifact was revised (new artifact id)."
      }
    },
    "artifact__validated": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "validator",
        "verdict"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "validator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "verdict": {
          "enum": [
            "pass",
            "fail",
            "warn"
          ]
        }
      },
      "x-blux-hook": {
        "name": "artifact.validated",
        "family": "artifact",
        "phase": "notify",
        "vetoable": false,
        "mutable": {},
        "sensitive": [],
        "emitters": "owner",
        "summary": "A validator reported on an artifact."
      }
    },
    "capability__after_execute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_id",
        "status",
        "duration_ms",
        "output_sha256"
      ],
      "properties": {
        "capability_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "status": {
          "enum": [
            "succeeded",
            "failed",
            "rejected",
            "cancelled"
          ]
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "output_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "x-blux-hook": {
        "name": "capability.after_execute",
        "family": "capability",
        "phase": "after",
        "vetoable": false,
        "mutable": {},
        "sensitive": [],
        "emitters": "runtime",
        "summary": "The capability finished."
      }
    },
    "capability__before_execute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_id",
        "version",
        "side_effects",
        "input_sha256"
      ],
      "properties": {
        "capability_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "side_effects": {
          "enum": [
            "none",
            "read",
            "write",
            "external",
            "destructive"
          ]
        },
        "input_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "x-blux-hook": {
        "name": "capability.before_execute",
        "family": "capability",
        "phase": "before",
        "vetoable": true,
        "mutable": {},
        "sensitive": [],
        "emitters": "runtime",
        "summary": "Before an authorized capability runs."
      }
    },
    "capability__discovered": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_id",
        "version",
        "side_effects",
        "provider_kind"
      ],
      "properties": {
        "capability_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "side_effects": {
          "enum": [
            "none",
            "read",
            "write",
            "external",
            "destructive"
          ]
        },
        "provider_kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "x-blux-hook": {
        "name": "capability.discovered",
        "family": "capability",
        "phase": "notify",
        "vetoable": false,
        "mutable": {},
        "sensitive": [],
        "emitters": "registry",
        "summary": "A capability was registered."
      }
    },
    "credential__requested": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "names",
        "purpose",
        "route_id"
      ],
      "properties": {
        "names": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "maxLength": 256
          }
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "route_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        }
      },
      "x-blux-hook": {
        "name": "credential.requested",
        "family": "credential",
        "phase": "notify",
        "vetoable": false,
