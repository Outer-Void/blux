{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:blux:hooks:v1:events",
  "title": "BLUX Hook System v1 events",
  "description": "Typed, versioned hook events. Each $defs.<event> describes one event's payload and carries the x-blux-hook catalog annotation (family, phase, vetoable, mutable fields and how they may change, sensitive fields, emitters).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "hooks_version",
    "event_id",
    "name",
    "version",
    "sequence",
    "emitted_at",
    "depth",
    "context",
    "payload"
  ],
  "properties": {
    "contract": {
      "const": "blux.hook-event"
    },
    "hooks_version": {
      "const": "1.0"
    },
    "event_id": {
      "type": "string",
      "pattern": "^evt_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "name": {
      "enum": [
        "agent.completed",
        "agent.failed",
        "agent.spawned",
        "artifact.created",
        "artifact.modified",
        "artifact.validated",
        "capability.after_execute",
        "capability.before_execute",
        "capability.discovered",
        "credential.requested",
        "model.after_call",
        "model.after_route",
        "model.before_call",
        "model.before_route",
        "reason.after",
        "reason.before",
        "receipt.created",
        "request.completed",
        "request.failed",
        "request.normalized",
        "request.received",
        "runtime.started",
        "runtime.starting",
        "runtime.stopped",
        "runtime.stopping",
        "security.violation",
        "session.closed",
        "session.created",
        "session.loaded",
        "tool.after_execute",
        "tool.authorized",
        "tool.before_authorize",
        "tool.before_execute",
        "tool.denied",
        "tool.failed",
        "training.eligible",
        "training.rejected"
      ]
    },
    "version": {
      "const": "1.0"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "emitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "depth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 16
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "parent_operation_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "project_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "capability_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "actor_type": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "actor_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        }
      }
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "name": {
            "const": "agent.completed"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/agent__completed"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "name": {
            "const": "agent.failed"
