{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:blux:migration:blhermes-parity-matrix:v1",
  "title": "BLHermes -> BLUX parity/migration matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "matrix_version", "inventory", "states", "network_dependencies", "features"],
  "properties": {
    "contract": {"const": "blux.blhermes-parity-matrix"},
    "matrix_version": {"const": 1},
    "inventory": {"const": "migration/blhermes/inventory.json"},
    "states": {"type": "array", "items": {"type": "string"}},
    "network_dependencies": {"type": "array", "items": {"type": "string"}},
    "features": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/feature"}}
  },
  "$defs": {
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "feature", "classification", "subsystems", "source_locations", "target", "tests",
                   "migration_state", "provenance", "network", "blocker", "evidence_plan", "inventory_categories"],
      "properties": {
        "id": {"type": "string", "pattern": "^BLH-[0-9]{3}$"},
        "feature": {"type": "string", "minLength": 3},
        "classification": {"enum": ["REMOVE", "REPLACE", "MIGRATE", "TEMPORARY_COMPATIBILITY", "UPSTREAM_ATTRIBUTION"]},
        "subsystems": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "source_locations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "target": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["repository", "module", "owner"],
              "properties": {
                "repository": {"type": "string", "pattern": "^Outer-Void/[A-Za-z0-9._-]+$"},
                "module": {"type": "string", "minLength": 3},
                "owner": {"type": "string", "minLength": 2}
              }
            }
          ]
        },
        "tests": {
          "type": "object",
          "additionalProperties": false,
          "required": ["characterization", "upstream"],
          "properties": {
            "characterization": {"type": "array", "items": {"type": "string", "pattern": "^tests/migration/"}},
            "upstream": {"type": "array", "items": {"type": "string"}}
          }
        },
        "migration_state": {"enum": ["NOT_STARTED", "CHARACTERIZED", "IN_PROGRESS", "MIGRATED", "PLANNED_REMOVAL",
                                     "KEPT_AS_ATTRIBUTION", "DEFERRED"]},
        "provenance": {
          "type": "object",
          "required": ["license", "holder", "notice", "lineage", "requirement"],
          "properties": {
            "license": {"const": "MIT"},
            "holder": {"const": "Nous Research"},
            "notice": {"const": "Copyright (c) 2025 Nous Research"},
            "lineage": {"const": "credits:LIN-001"},
            "requirement": {"type": "string", "minLength": 10},
            "third_party": {"type": "string"}
          }
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dependency", "endpoints", "policy"],
          "properties": {
            "dependency": {"enum": ["none", "local", "optional", "required", "build_time"]},
            "endpoints": {"type": "array", "items": {"type": "string"}},
            "policy": {"type": "string"}
          }
        },
        "blocker": {"type": ["string", "null"]},
        "evidence_plan": {"type": "string"},
        "inventory_categories": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
