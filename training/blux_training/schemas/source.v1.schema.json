{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:blux:training:v1:source",
  "title": "BLUX trajectory source (input to the training pipeline)",
  "description": "One candidate trajectory: an explicit eligibility declaration, the BLUX receipts of the operation (none for synthetic sources) and the explicit, BLUX-owned trajectory structure. Provider hidden reasoning has no field here and is rejected wherever it appears.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "version",
    "source_type",
    "source_project",
    "eligibility",
    "receipts",
    "trajectory",
    "licenses",
    "model_versions",
    "engine_versions"
  ],
  "properties": {
    "kind": {
      "const": "blux.trajectory-source"
    },
    "version": {
      "const": "1"
    },
    "source_type": {
      "enum": [
        "synthetic",
        "blux-operation",
        "engine-fixture"
      ]
    },
    "source_project": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "split_hint": {
      "enum": [
        "holdout",
        "test",
        "regression"
      ],
      "description": "Curated evaluation items only. A hint can protect a record, never move it into train."
    },
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis",
        "data_class"
      ],
      "properties": {
        "basis": {
          "enum": [
            "synthetic",
            "owner-approved"
          ]
        },
        "data_class": {
          "enum": [
            "synthetic",
            "public",
            "private"
          ]
        },
        "approved_by": {
          "type": "string",
          "minLength": 1
        },
        "approved_at": {
          "type": "string",
          "format": "date"
        },
        "note": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "receipts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "trajectory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input",
        "intent",
        "final_result",
        "accept_reject"
      ],
      "properties": {
        "input": {},
        "intent": {
          "type": "string",
          "minLength": 1
        },
        "context_summary": {
          "type": "string"
        },
        "reasoning_structure": {
          "type": "object",
          "description": "Explicit structure (plans, claims, evidence), never free-form model reasoning."
        },
        "planned_actions": {
          "type": "array"
        },
        "tool_calls": {
          "type": "array"
        },
        "tool_results": {
          "type": "array"
        },
        "constructed_artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "artifact_id",
              "license"
            ],
            "properties": {
              "artifact_id": {
                "type": "string"
              },
              "license": {
                "type": "string"
              }
            }
          }
        },
        "validation_results": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "check",
              "passed"
            ],
            "properties": {
              "check": {
                "type": "string"
              },
              "passed": {
                "type": "boolean"
              }
            }
          }
        },
        "repair_iterations": {
          "type": "integer",
          "minimum": 0
        },
        "final_result": {},
        "accept_reject": {
          "enum": [
            "accept",
            "reject"
          ]
        }
      }
    },
    "licenses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "subject",
          "spdx"
        ],
        "properties": {
          "subject": {
            "type": "string"
          },
          "spdx": {
            "type": "string"
          }
        }
      }
    },
    "model_versions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "engine_versions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "safety_class": {
      "enum": [
        "benign",
        "adversarial"
      ],
      "description": "Adversarial items (prompt injection, smuggled fields) are kept as labelled negative examples."
    }
  }
}
